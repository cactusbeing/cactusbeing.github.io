# Exam regression checks ship with the feature; local review notes stay ignored.
!/scripts/test-exam.mjs
!/scripts/playtest-exam.mjs

# Four authored dialogue branch audits must also run in CI.
!/scripts/test-chat-relay-branches.mjs
!/scripts/playtest-chat-relay-branches.mjs
!/docs/chat-relay/
/docs/chat-relay/*
