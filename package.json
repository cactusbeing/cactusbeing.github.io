{
  "name": "cactusbeing-education",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run test:materials && npm run test:bakery && npm run test:chat-relay && npm run test:exam && vue-tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:clean": "node scripts/check-clean-build.mjs",
    "test:materials": "node scripts/test-upload-materials.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:bakery": "node --experimental-strip-types scripts/test-bakery.mjs",
    "test:money": "node --experimental-strip-types scripts/test-money.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:exam": "node --experimental-strip-types scripts/test-exam.mjs",
    "test:chat-relay": "node --experimental-strip-types scripts/test-chat-relay.mjs && node --experimental-strip-types scripts/test-chat-relay-branches.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "katex": "^0.19.1",
    "phaser": "^3.90.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
